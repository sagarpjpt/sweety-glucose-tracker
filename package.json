{
  "name": "sweety",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/seed.js",
    "test": "node --env-file-if-exists=.env --test tests/*.test.js",
    "format:check": "prettier --check client server scripts tests *.js *.json *.html *.yml README.md"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.1.0-beta.15",
    "prettier": "^3.10.1",
    "supertest": "^7.1.4",
    "vite": "^7.2.0"
  }
}
